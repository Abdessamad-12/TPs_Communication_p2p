<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://java.sun.com/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://java.sun.com/xml/ns/javaee
         http://java.sun.com/xml/ns/javaee/web-app_2_5.xsd"
         version="2.5">

    <display-name>HttpServletLab-TP1</display-name>

    <welcome-file-list>
        <welcome-file>greetings.html</welcome-file>
    </welcome-file-list>

    <servlet>
        <servlet-name>GreetingServlet</servlet-name>
        <servlet-class>exple1.GreetingServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>GreetingServlet</servlet-name>
        <url-pattern>/hello</url-pattern>
    </servlet-mapping>

    <filter>
        <filter-name>BlacklistFilter</filter-name>
        <filter-class>exple1.BlacklistFilter</filter-class>
        <init-param>
            <param-name>blacklist</param-name>
            <param-value>badname,evil,hacker</param-value>
        </init-param>
    </filter>

    <filter-mapping>
        <filter-name>BlacklistFilter</filter-name>
        <url-pattern>/hello</url-pattern>
    </filter-mapping>

</web-app>
